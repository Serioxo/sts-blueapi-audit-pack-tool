# Port the web tool listens on.
PORT=3000

# Base URL of the Blue API (no trailing slash).
BLUE_API_BASE_URL=https://sign.bluemotorfinance.co.uk

# Optional credentials forwarded to the Blue API if it requires them.
# Leave blank if the endpoints are reachable without authentication.
# BLUE_API_COOKIE=".AspNetCore.Session=...; other=..."
# BLUE_API_AUTH="Bearer <token>"
